root = true

[*.cs]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_diagnostic.CA1062.severity = none
# "Shared" is an established public assembly/namespace name; renaming it would break consumers.
dotnet_diagnostic.CA1716.severity = none

[JobPortal.Persistence/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
