{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=JobPortalDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "JobPortal",
    "Audience": "JobPortal.Client",
    "Key": "CHANGE_THIS_TO_A_SECURE_32_CHARACTER_MINIMUM_SECRET_KEY",
    "AccessTokenLifetimeMinutes": 15
  },
  "Email": {
    "Enabled": false,
    "FromAddress": "no-reply@jobportal.example",
    "VerificationUrl": "https://app.jobportal.example/verify-email",
    "PasswordResetUrl": "https://app.jobportal.example/reset-password",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": ""
    }
  },
  "Razorpay": {
    "KeyId": "CONFIGURE_IN_USER_SECRETS_OR_ENVIRONMENT",
    "KeySecret": "CONFIGURE_IN_USER_SECRETS_OR_ENVIRONMENT",
    "WebhookSecret": "CONFIGURE_IN_USER_SECRETS_OR_ENVIRONMENT"
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "Email": "",
    "Password": "",
    "FirstName": "",
    "LastName": ""
  },
  "Membership": {
    "DefaultPlan": {
      "Name": "Job Application Access",
      "Amount": 99,
      "CurrencyCode": "INR",
      "DurationDays": 30
    }
  },
  "ResumeStorage": {
    "RootPath": "App_Data/resumes"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.jobportal.example"
    ]
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/jobportal-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
